# Aplicación
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# PostgreSQL
# El puerto se publica en el host para permitir conexiones desde pgAdmin 4 Desktop externo.
POSTGRES_USER=ule_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=ule_tonalmaster
POSTGRES_PORT=5432

# API y migraciones: usan el hostname interno `db` de Docker Compose.
DATABASE_URL=postgres://ule_user:secure_password@db:5432/ule_tonalmaster?sslmode=disable

# Orígenes permitidos para la API HTTP.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173
\n# Código temporal requerido para POST /api/v1/auth/register\nREGISTRATION_CODE=change-me\n